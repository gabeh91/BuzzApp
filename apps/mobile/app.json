{
  "expo": {
    "name": "Buzz",
    "slug": "buzz",
    "scheme": "buzz",
    "version": "1.0.0",
    "orientation": "portrait",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.buzz.dev"
    },
    "android": {
      "package": "com.buzz.dev"
    },
    "plugins": [
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Buzz to use Face ID to unlock your saved session."
        }
      ],
      "expo-secure-store"
    ]
  }
}
