{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "baseUrl": ".",
    "paths": {
      "@buzz/config": ["packages/config/src/index.ts"],
      "@buzz/shared-types": ["packages/shared-types/src/index.ts"],
      "@buzz/ui": ["packages/ui/src/index.ts"],
      "@buzz/validation": ["packages/validation/src/index.ts"]
    }
  }
}
